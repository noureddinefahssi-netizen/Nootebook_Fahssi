(* ============================================================ *)
(* Permanents of Squarefree Hankel Matrices                     *)
(* Mathematica 12.0 Code                                        *)
(* ============================================================ *)

(* 1. Definition of basic functions *)
mu2[m_Integer] := Boole[SquareFreeQ[m]];
M[n_Integer] := Table[mu2[i + j], {i, 1, n}, {j, 1, n}];
Q[n_Integer] := Permanent[M[n]];

(* 2. Function to count t_n (squarefree integers in [n+2, 2n+1]) *)
t[n_Integer] := Count[Range[n + 2, 2 n + 1], _?SquareFreeQ];

(* 3. Find the exceptions where 2*t_n - n < 2 over the finite   *)
(*    range 2 <= n <= 6181                                      *)
exceptions = Select[Range[2, 6181], 2*t[#] - # < 2 &]
(* Expected output: {2, 4, 5, 6, 13, 14} *)

(* 4. Calculate the permanents Q_n and Q_{n+1} for exceptions   *)
Table[{n, Q[n], Q[n + 1]}, {n, exceptions}]
(* Expected output: 
   {{2, 1, 2}, {4, 9, 20}, 
    {5, 20, 55}, {6, 55, 205}, 
    {13, 22997391, 136484073}, 
    {14, 136484073, 960485193}}  *)
